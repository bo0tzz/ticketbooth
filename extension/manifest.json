{
  "manifest_version": 2,
  "name": "Ticketbooth",
  "version": "0.0.0",
  "description": "Reloads a tab so the request lands on the server at an exact moment.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ticketbooth@ticketbooth",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "permissions": ["storage", "tabs"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_title": "Ticketbooth",
    "default_icon": "icon.svg",
    "default_popup": "popup.html"
  }
}
